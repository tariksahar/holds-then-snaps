# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# figures/ IS committed. The figures are part of the deliverable: the report
# includes them, and a reader of the repository front page should see them
# without running anything. They are regenerated by
# `python build_report.py --figures`, which reads only files under results/ -
# so regenerating them is a check on the numbers rather than a chore.

# results/ IS committed. It holds the Phase C sweep: the raw grid, the payoff
# matrices behind it, and the metadata saying what produced them. It is the
# experimental record, not a build artifact - the report cites it, and a reader
# should be able to check the analysis without re-running a 20-minute sweep.
# Everything in it is deterministic from the root seed, so it can also be
# regenerated; being reproducible is not a reason to leave it out.

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# LaTeX build products. The report PDF is built, not committed: it is derived
# from report/report.tex plus the committed figures, and `python
# build_report.py` reproduces it. The figures themselves ARE committed - they
# are inputs to the report and readable on the repository page without a TeX
# installation.
report/*.aux
report/*.bbl
report/*.blg
report/*.fdb_latexmk
report/*.fls
report/*.log
report/*.out
report/*.synctex.gz
report/*.toc
report/report.pdf
